# AI / LLM / ASR configuration — copy to config/ai.env and edit on the VM.
# This file is loaded by docker compose for api + ai-bundle (see docker-compose.yml).
# Switch providers here after deployment without rebuilding images.
#
# Cloud (initial deploy):  LLM_PROVIDER=huggingface + HF_API_TOKEN
# Local LLM (post-deploy): LLM_PROVIDER=ollama + OLLAMA_BASE_URL (see demo/docs/VM-RUNBOOK.md §6)

# --- Provider ---
# huggingface | ollama
LLM_PROVIDER=huggingface

# --- Hugging Face (cloud LLM + cloud ASR) ---
# Token: https://huggingface.co/settings/tokens — Inference Providers permission
HF_API_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_API_BASE=https://router.huggingface.co/v1
LLM_REQUEST_TIMEOUT_MS=600000

HF_ASR_MODEL=openai/whisper-large-v3
# Optional dedicated ASR endpoint (leave empty for HF router default)
HF_ASR_API_URL=
ASR_REQUEST_TIMEOUT_MS=600000

# --- Ollama (local LLM — set LLM_PROVIDER=ollama) ---
# From containers use host gateway, e.g. after installing Ollama on the VM:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# --- Extraction tuning ---
NLP_CONFIDENCE_THRESHOLD=0.65
