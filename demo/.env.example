# DCF AIT demo stack — copy to .env (see config/ai-defaults.env for AI model defaults)

AIT_HTTP_PORT=4010
APP_BASE_PATH=/dcfintake
VITE_BASE_PATH=/dcfintake/
VITE_API_BASE_URL=/dcfintake/api/v1
BEHIND_REVERSE_PROXY=1

PUBLIC_ORIGIN=https://foundry.inapp.com
CORS_ORIGIN=https://foundry.inapp.com

JWT_SECRET=change-me-jwt-secret-min-32-chars-long
INTERNAL_API_KEY=change-me-internal-api-key
NODE_ENV=production

# AI — Hugging Face (transcription + LLM; no local model RAM)
# Token: https://huggingface.co/settings/tokens — Inference Providers permission
HF_API_TOKEN=
LLM_PROVIDER=huggingface
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_API_BASE=https://router.huggingface.co/v1
LLM_REQUEST_TIMEOUT_MS=600000
HF_ASR_MODEL=openai/whisper-large-v3
HF_ASR_API_URL=
ASR_REQUEST_TIMEOUT_MS=600000

# Optional local Ollama fallback (set LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

NLP_CONFIDENCE_THRESHOLD=0.65

# Demo-only: set to 4 to show mock CCWIS clinical-review triage flag (0 = off)
DEMO_MOCK_CCWIS_PRIOR_INCIDENTS=0
