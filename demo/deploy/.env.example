# PM2 production env — copied to ../.env on first start.sh run.
# AI / LLM / ASR: config/ai.env (see demo/docs/DEPLOY-RUNBOOK.md)

APP_NAME=intake-demo
HOST=127.0.0.1
# Loopback ports (11110+ on shared demo hosts)
PORT=11110

APP_BASE_PATH=/intake
VITE_BASE_PATH=/intake/
VITE_API_BASE_URL=/intake/api/v1
BEHIND_REVERSE_PROXY=1

PUBLIC_ORIGIN=https://client-demo.inapp.com
CORS_ORIGIN=https://client-demo.inapp.com

JWT_SECRET=change-me-jwt-secret-min-32-chars-long
INTERNAL_API_KEY=change-me-internal-api-key
NODE_ENV=production

DATABASE_URL=sqlite:///./data/ait.db
ARTIFACT_DIR=./data/artifacts
API_BASE_URL=http://127.0.0.1:11110/api/v1

# Host nginx route (configure-nginx.sh — one snippet file only; other routes untouched)
NGINX_ROUTE=intake
NGINX_DOMAIN=client-demo.inapp.com
NGINX_ROUTES_DIR=/etc/nginx/routes
# Set to 0 if ops manages nginx manually (start.sh will not write any files)
NGINX_MANAGED=1

# Demo-only: set to 4 to show mock prior-incident triage flag (0 = off)
DEMO_MOCK_CCWIS_PRIOR_INCIDENTS=0
