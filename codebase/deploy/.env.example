# DCF AIT Demo — copy to .env and set secrets before docker compose up
#
# --- Database (use external Postgres OR bundled container) ---
# External (recommended when you already run Postgres on the host):
USE_EXTERNAL_POSTGRES=1
# From inside Docker, reach host Postgres via host.docker.internal (not 127.0.0.1)
DATABASE_URL=postgresql://foundry:foundry@host.docker.internal:5432/appdb

# Bundled Postgres (only if USE_EXTERNAL_POSTGRES is empty and you start profile bundled-db):
# COMPOSE_PROFILES=bundled-db
# POSTGRES_USER=ait
# POSTGRES_PASSWORD=change-me-strong-password
# POSTGRES_DB=ait

# Host ports (4010-4015 block — POSTGRES_HOST_PORT only used with bundled-db profile)
AIT_HTTP_PORT=4010
AIT_HTTPS_PORT=4011
AIT_API_PORT=4012
MINIO_HOST_PORT=4013
MINIO_CONSOLE_PORT=4014
POSTGRES_HOST_PORT=4015

# Production:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#   See Docs/HANDOVER.md and Docs/SEED-005-OWASP-CLOSEOUT.md

# MinIO (S3-compatible artifact store)
MINIO_ROOT_USER=aitminio
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_BUCKET=ait-artifacts

# API
JWT_SECRET=change-me-jwt-secret-min-32-chars
NODE_ENV=production

# Public URL: https://foundry.inapp.com/dcfintake/ (path prefix below)
PUBLIC_ORIGIN=https://foundry.inapp.com
APP_BASE_PATH=/dcfintake

# VM already has nginx on :80/:443 — proxy to AIT_HTTP_PORT (4010), not container :443
BEHIND_REVERSE_PROXY=1
VITE_BASE_PATH=/dcfintake/
VITE_API_BASE_URL=/dcfintake/api/v1
CORS_ORIGIN=https://foundry.inapp.com

# Local dev without path prefix (vite/npm run dev only):
# APP_BASE_PATH=
# VITE_BASE_PATH=/
# VITE_API_BASE_URL=/api/v1
# CORS_ORIGIN=https://localhost:4011

# Audit
AUDIT_RETENTION_DAYS=90

# Ollama SLM (internal Docker network only)
OLLAMA_MODEL=llama3.2:3b

# ASR in ai-worker (faster-whisper)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# NLP merge policy
NLP_CONFIDENCE_THRESHOLD=0.65

# Worker ↔ API internal callbacks (must match on api and ai-worker)
INTERNAL_API_KEY=change-me-internal-api-key

# Redis (pipeline queue — use bundled container name on ait-net)
REDIS_URL=redis://redis:6379
